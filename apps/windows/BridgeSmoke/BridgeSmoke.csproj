<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Interop smoke test for the Swift core's C ABI (packages/DrillBridge/include/fieldwork_core.h).
    Build the DLL first:
      swift build -c release (product FieldworkCore) in packages/DrillBridge
    The Swift runtime DLLs (swiftCore, Foundation, ...) must be on PATH; a packaged
    app will ship them from the toolchain's Redistributables instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <CoreDll>$(MSBuildThisFileDirectory)..\..\..\packages\DrillBridge\.build\out\Products\Release-windows-x86_64\FieldworkCore.dll</CoreDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CoreDll)" Condition="Exists('$(CoreDll)')" CopyToOutputDirectory="PreserveNewest" Link="FieldworkCore.dll" />
  </ItemGroup>

  <Target Name="RequireCoreDll" BeforeTargets="Build" Condition="!Exists('$(CoreDll)')">
    <Error Text="FieldworkCore.dll not found. Run: swift build -c release --product FieldworkCore --package-path packages/DrillBridge" />
  </Target>

</Project>
